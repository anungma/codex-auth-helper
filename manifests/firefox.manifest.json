{
  "manifest_version": 2,
  "name": "Codex Auth Exporter",
  "short_name": "Codex Auth Exporter",
  "version": "1.2.3",
  "description": "Securely export your logged-in ChatGPT session configuration locally, generating a Codex-compatible auth.json backup file. Fully local and offline processing.",
  "permissions": [
    "downloads",
    "tabs",
    "https://chatgpt.com/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "incognito": "spanning",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "codex-auth-exporter@local",
      "strict_min_version": "109.0"
    }
  }
}
